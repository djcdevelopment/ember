{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Ember": "Information"
    }
  },
  "Discord": {
    "BotToken": "",
    "ClientId": "",
    "GuildId": "",
    "OwnerUserId": ""
  },
  "Ember": {
    "DatabasePath": "ember.db",
    "GateCountdownSeconds": 300,
    "MaxPlanRounds": 6,
    "WorktreeRoot": "worktrees",
    "WorktreeRetentionDays": 7,
    "Builder": {
      "Command": "claude",
      "SkipPermissions": true,
      "Bare": false,
      "MaxBudgetUsd": 10,
      "VerifyCommand": "dotnet build",
      "VerifyTimeoutMinutes": 10,
      "ExtraArgs": [],
      "TimeoutMinutes": 30
    },
    "Manifest": {
      "Command": "python",
      "ExtraArgs": ["-m", "constellation_manifest.cli"],
      "TimeoutSeconds": 30,
      "MaxSchemaVersion": 1
    },
    "Repos": {
      "ember": "D:\\work\\ember",
      "tempo": {
        "path": "D:\\World of Warcraft\\Tempo",
        "constellation": "D:\\work\\gad\\constellation.yaml"
      }
    }
  },
  "Models": {
    "Planner": {
      "Provider": "anthropic",
      "Model": "claude-sonnet-4-5",
      "ApiKey": ""
    },
    "Critic": {
      "Provider": "openai",
      "Model": "gpt-4o",
      "ApiKey": ""
    }
  },
  "Otel": {
    "ServiceName": "ember",
    "Endpoint": ""
  }
